[Unit]
Description=Minecraft No-Port-Forwarding Manager
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=minecraft-panel
Group=minecraft-panel
SupplementaryGroups=docker
WorkingDirectory=/opt/minecraft-panel
EnvironmentFile=/opt/minecraft-panel/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/minecraft-panel/.venv/bin/gunicorn --workers 2 --bind 0.0.0.0:8080 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=minecraft-panel
ReadWritePaths=/opt/minecraft-panel/config
ReadWritePaths=/srv/minecraft/servers
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
