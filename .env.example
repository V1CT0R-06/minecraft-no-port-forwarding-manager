# Generate these values using the commands in README.md.
PANEL_SECRET_KEY=
PANEL_USERNAME=admin
PANEL_PASSWORD_HASH=

# Development server settings. 0.0.0.0 works with DHCP and NetBird.
PANEL_HOST=0.0.0.0
PANEL_PORT=8080
PANEL_COOKIE_SECURE=false

# Labels and paths. Change these to suit your own homelab.
PANEL_TITLE=Minecraft Homelab
PLAYIT_AGENT_NAME=my-minecraft-host
MINECRAFT_DNS_ZONE=example.com
MINECRAFT_SERVER_ROOT=/srv/minecraft/servers
MINECRAFT_SHARED_ENV_FILE=/etc/minecraft-panel/minecraft.env
